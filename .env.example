# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ---- Web app (read at build time by Vite) ----------------------------------------
# Server mode: the SIMRS API, usually "/api" when the API serves the web app itself.
# Leave empty to run in local (browser-only) mode, e.g. in AI Studio.
VITE_API_URL=""
# Show the preset demo accounts on the login screen (demo deployments only).
VITE_DEMO_MODE="false"

# ---- API server (server/) -------------------------------------------------------
# PostgreSQL database owned by the SIMRS user. See docs/operations/campus-deployment.md.
DATABASE_URL="postgres://simrs_owner:CHANGE_ME@localhost:5432/simrs"
# Secret for login tokens, at least 32 random characters (e.g. `openssl rand -base64 48`).
JWT_SECRET=""
PORT="8080"
# Apply db/migrations and db/seed.sql when the server starts.
MIGRATE_ON_START="true"
